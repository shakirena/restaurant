function editPriceSellIndex(id,price,id_role)
{
	if (id_role != 2)
	{
		$("#login-modal").modal("show")
			.find("#loginContent")
			.load('login-price?id='+id+"&price="+price);
	
	}
	else {
			$.get('update-price', {id:id,price:price},function(data){
				$.pjax.reload({container:"#grid-update"});
				$("#sum"+id).html(data);
			});	
	}
}

