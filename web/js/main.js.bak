function changePos()
{
	 var quantity = prompt("Сколько  ?", 1);
        if (quantity) {
		
			$("#virtual").val(quantity);
			var sdacha=$("#sum").text() - $("#money").val()// - quantity ;
            sdacha = sdacha - quantity;
			sdacha=-sdacha.toFixed(2);
			$("#sdacha").html(sdacha);
            
		}
}
